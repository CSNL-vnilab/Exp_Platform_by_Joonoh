        <mxCell id="title" value="(향후 가능성)  자연어 조회" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#555" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1520" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="데이터가 이미 구조화되어 있어 사전 조건은 충족됨 — 자연어를 안전한 사전 정의 질의로 바꾸는 층이 추가되면 가능" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#777;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="124" width="1520" height="22" as="geometry" />
        </mxCell>

        <!-- 4 boxes left to right -->
        <mxCell id="b1" value="사용자가 자연어로 질문&#10;( 무엇 / 어디 / 언제 )" style="dashed=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999;strokeWidth=2;fontSize=13;fontColor=#555" vertex="1" parent="1">
          <mxGeometry x="80" y="260" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="AI 변환기&#10;사전 정의된 안전한&#10;질의 형식으로 매핑" style="dashed=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999;strokeWidth=2;fontSize=13;fontColor=#555" vertex="1" parent="1">
          <mxGeometry x="490" y="260" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="데이터베이스 질의 실행&#10;( 현재 시스템과 동일 )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=13;fontColor=#1f4e79" vertex="1" parent="1">
          <mxGeometry x="900" y="260" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="결과 반환&#10;( 필요시 자연어로 재포맷 )" style="dashed=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999;strokeWidth=2;fontSize=13;fontColor=#555" vertex="1" parent="1">
