        <!-- Why / Risk panels -->
        <mxCell id="why-h" value="왜 가능한가" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#1f4e79" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="why-body" value="모든 실험 · 예약 · 참여자 · 청구 항목이 이미 구조화된 데이터로 저장되어 있다 (앞 ①〜⑤ 그림).&#10;AI 도구는 이미 인프라에 존재한다 (코드 자동 분석에 사용 중).&#10;정형화 가능한 질문은 사전 정의된 안전한 질의로 환원 가능하다." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444;spacing=8" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="700" height="140" as="geometry" />
        </mxCell>

        <mxCell id="risk-h" value="주의할 점" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#d97706" vertex="1" parent="1">
          <mxGeometry x="820" y="480" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="risk-body" value="AI가 자유 질의를 생성하면 잘못된 결과를 그럴듯하게 반환할 위험이 있다.&#10;따라서 자유 생성이 아니라 사전 정의된 질의에서 골라 매개변수만 채우는 방식이 안전하다.&#10;새 질문 유형이 필요할 때마다 해당 질의를 사람이 검증해 묶음에 추가하는 거버넌스가 함께 필요하다." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#444;spacing=8" vertex="1" parent="1">
          <mxGeometry x="820" y="510" width="700" height="140" as="geometry" />
        </mxCell>

        <mxCell id="note" value="이 그림은 미래 계획의 개념도이며 본 시스템의 현재 동작에는 포함되지 않는다 — 회색 점선이 그 의미다." style="text;html=1;align=center;fontSize=12;fontColor=#666;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1480" height="36" as="geometry" />
        </mxCell>

