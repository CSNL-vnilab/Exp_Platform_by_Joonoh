        <mxCell id="status" value="현재 미구현 — 미래 계획 (개념도)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;strokeWidth=2;dashed=1;fontSize=13;fontStyle=2;fontColor=#666" vertex="1" parent="1">
